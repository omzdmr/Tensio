<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/statusText" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingTop="12dp"
        android:text="Starting camera…" android:textSize="16sp" />
    <TextView android:id="@+id/urlText" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingTop="4dp"
        android:textIsSelectable="true" android:textSize="14sp" />
</LinearLayout>
